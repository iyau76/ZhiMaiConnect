# Test artifacts
coverage/
playwright-report/
test-results/

# Generated release bundles stay local, but the release tooling and its notes
# are source: keep them tracked so a fresh clone can cut the next release.
release/**
!release/*.md
!release/*.mjs
!release/SHA256SUMS.txt

# Keep full-resolution art masters locally; ship optimized assets from art/web.
/src/assets/art/*.png

# Private source material and locally produced video assets are not part of the
# public application repository.
/doc/background/
/videos/
/doc.zip

# Local publicity deliverables and scratch: exported posters/trifold PDFs and
# PPT builds, generated exploration art, raw brand references.
/output/
/src/assets/publicity/
/.tmp/
/tmp/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
