{
  "name": "zhimai-connect",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/configure-cloudflare-build.mjs",
    "build:dev": "vite build --mode development && node scripts/configure-cloudflare-build.mjs",
    "preview": "wrangler dev --config .output/server/wrangler.json --ip 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run"
  },
