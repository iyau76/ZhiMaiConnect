# Optional server-side key for Lovable AI vision and transcription requests.
# Leave empty when using a custom OpenAI-compatible endpoint or local Ollama.
LOVABLE_API_KEY=

# Optional comma-separated exact hostnames allowed by the custom AI server proxy.
# Wildcards, IP literals, local names, ports, paths, and schemes are not accepted here.
AI_PROXY_ALLOWED_HOSTS=
